{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.14.1",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "lucidIT, LLC (o-MATIC)",
    "websiteUrl": "https://o-matic.ai",
    "privacyUrl": "${{TODO_OMATIC_PRIVACY_URL}}",
    "termsOfUseUrl": "${{TODO_OMATIC_TERMS_URL}}"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Andy (o-MATIC)",
    "full": "Andy, Photography Coach from o-MATIC"
  },
  "description": {
    "short": "Photography coach. Reviews photos and gives edit recipes.",
    "full": "Photography Coach from o-MATIC. Asks where a photograph is going before grading it, measures and edits it on Affinity Photo by calibrating rather than guessing, and delivers exact improvement recipes, scoring and darkroom notes."
  },
  "accentColor": "#00B5AD",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "andyAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity"
  ],
  "validDomains": []
}
