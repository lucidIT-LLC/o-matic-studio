{
  "description": "o-MATIC Studio: Brandy's standing claim watch (Stop, task #963) and the host role-adapter check (SessionStart, task #983). Read hooks/README.md.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brand_claim_watch.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/verify-adapter-paths.mjs\" --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
